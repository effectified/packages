{
  "name": "@effectified/fluentui-web-components",
  "version": "3.2.6",
  "description": "@fluentui/web-components for Effect UI: typed bindings and mounts, its events as messages, its instances scoped to their elements",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effectified/packages.git",
    "directory": "targets/fluentui__web-components/package"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./elements/*": {
      "types": "./dist/elements/*.d.ts",
      "import": "./dist/elements/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "sideEffects": [
    "./dist/elements/*.js",
    "./dist/index.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest --run --passWithNoTests --testTimeout=60000",
    "demo": "node test/support/demo.ts"
  },
  "dependencies": {
    "@fluentui/web-components": "3.2.5"
  },
  "peerDependencies": {
    "@effect/ui": "*",
    "effect": "~4.1.5"
  },
  "devDependencies": {
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@2fd1a57",
    "@effect/vitest": "4.1.5",
    "@effectified/puppeteer-core": "https://github.com/effectified/engine/releases/download/puppeteer-core-v25.19.0+2/effectified-puppeteer-core-25.19.0+2.tgz",
    "@fluentui/tokens": "1.0.0-alpha.25",
    "@types/node": "26.6.7",
    "effect": "4.1.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "effectified": {
    "upstream": "@fluentui/web-components@3.2.5",
    "effectUi": "2fd1a57"
  }
}
