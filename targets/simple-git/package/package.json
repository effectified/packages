{
  "name": "@effectified/simple-git",
  "version": "4.1.6",
  "description": "simple-git in Effect: its async calls as traced Effects, absent values as Options, its iterables as Streams, its resources scoped, its failures tagged",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effectified/packages.git",
    "directory": "targets/simple-git/package"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@simple-git/argv-parser": "3.0.0",
    "simple-git": "4.1.0"
  },
  "peerDependencies": {
    "effect": "~4.1.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.5",
    "@types/node": "26.6.7",
    "effect": "4.1.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "effectified": {
    "engine": "0.5.0",
    "upstream": "simple-git@4.1.0",
    "types": "simple-git@4.1.0"
  }
}
