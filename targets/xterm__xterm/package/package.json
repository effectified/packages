{
  "name": "@effectified/xterm",
  "version": "6.0.0",
  "description": "@xterm/xterm for Effect UI: typed bindings and mounts, its events as messages, its instances scoped to their elements",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./elements/*": {
      "types": "./dist/elements/*.d.ts",
      "import": "./dist/elements/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/elements/*.js",
    "./dist/index.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest --run --passWithNoTests --testTimeout=60000"
  },
  "dependencies": {
    "@xterm/xterm": "6.0.0"
  },
  "peerDependencies": {
    "@effect/ui": "*",
    "effect": "~4.1.5"
  },
  "devDependencies": {
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@2fd1a57",
    "@effect/vitest": "4.1.5",
    "@effectified/puppeteer-core": "https://github.com/effectified/engine/releases/download/puppeteer-core-v25.19.0+2/effectified-puppeteer-core-25.19.0+2.tgz",
    "@types/node": "26.6.7",
    "effect": "4.1.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "effectified": {
    "upstream": "@xterm/xterm@6.0.0",
    "effectUi": "2fd1a57"
  }
}
