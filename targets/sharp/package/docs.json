    "tag": "sharp-v0.35.5+3"
  },
  "tests": 2,
  "examples": [
    {
      "title": "Resize an image and read its metadata",
      "source": "test/facade.test.ts",
      "code": "import { sharp } from \"@effectified/sharp\";\n\nconst red = { create: { width: 4, height: 2, channels: 3, background: \"#ff0000\" } } as const;\n\nconst image = yield* sharp(red);\n// The builder chain stays synchronous; toBuffer runs it, as an Effect.\nconst png = yield* image.resize(2, 1).png().toBuffer();\nconst metadata = yield* (yield* sharp(png)).metadata();\n"
    }
  ],
