{
  "schema": 1,
  "name": "@effectified/sharp",
  "slug": "sharp",
  "kind": "runtime",
  "tagline": "a builder that is also a Node stream",
  "description": "sharp in Effect: its async calls as Effects, its iterables as Streams, its resources scoped, its failures tagged",
